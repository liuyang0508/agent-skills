{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "plan",
        "render"
      ]
    },
    "intent": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "explicit_format": {
          "enum": [
            "markdown",
            "html",
            "mermaid",
            "svg",
            "pdf",
            "pptx",
            "mp4"
          ]
        },
        "teaching": {
          "type": "boolean"
        },
        "learning_aids_required": {
          "type": "boolean"
        }
      },
      "required": [
        "goal"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "text",
                  "comparison",
                  "series",
                  "relations",
                  "steps"
                ]
              },
              "data": {
                "type": "object"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "uncertainty_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "kind",
              "data",
              "evidence_ids",
              "uncertainty_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "locator",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "affected_block_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "text",
              "affected_block_ids"
            ],
            "additionalProperties": false
          }
        },
        "change_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "result_id",
        "revision",
        "summary",
        "blocks",
        "evidence",
        "uncertainties"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "agent_callbacks": {
          "type": "boolean"
        }
      },
      "required": [
        "surface",
        "renderers",
        "agent_callbacks"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "requires_new_evidence": {
          "type": "boolean"
        },
        "requires_automatic_actions": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "editable": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "comprehension_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "success_criteria": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "user",
              "inferred"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "success_criteria",
          "origin"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "learner_context": {
      "type": "object",
      "properties": {
        "known_concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "block_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "text",
              "source_ref"
            ],
            "additionalProperties": false
          }
        },
        "confusions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "block_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "text",
              "source_ref"
            ],
            "additionalProperties": false
          }
        },
        "preferred_depth": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "block_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "text",
                "source_ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "block_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "text",
              "source_ref"
            ],
            "additionalProperties": false
          }
        },
        "check_consent": {
          "enum": [
            "not_asked",
            "accepted",
            "declined"
          ]
        }
      },
      "required": [
        "known_concepts",
        "confusions",
        "preferred_depth",
        "feedback",
        "check_consent"
      ],
      "additionalProperties": false
    },
    "session_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "history_status": {
      "enum": [
        "first",
        "available",
        "unavailable"
      ]
    },
    "baseline": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "result": {
              "type": "object",
              "properties": {
                "result_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "text",
                          "comparison",
                          "series",
                          "relations",
                          "steps"
                        ]
                      },
                      "data": {
                        "type": "object"
                      },
                      "evidence_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      },
                      "uncertainty_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "data",
                      "evidence_ids",
                      "uncertainty_ids"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "locator",
                      "title"
                    ],
                    "additionalProperties": false
                  }
                },
                "uncertainties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "affected_block_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "id",
                      "text",
                      "affected_block_ids"
                    ],
                    "additionalProperties": false
                  }
                },
                "change_reasons": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "result_id",
                "revision",
                "summary",
                "blocks",
                "evidence",
                "uncertainties"
              ],
              "additionalProperties": false
            },
            "spec_ref": {
              "type": "string",
              "minLength": 1
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "id_map": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "mode",
    "intent",
    "result",
    "capabilities",
    "constraints",
    "comprehension_goals",
    "learner_context",
    "session_refs",
    "history_status",
    "baseline"
  ],
  "additionalProperties": false
}
