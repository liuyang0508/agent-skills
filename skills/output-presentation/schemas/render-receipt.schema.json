{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "result_ref": {
      "type": "object",
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "result_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "renderer_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "generated",
        "validated",
        "failed",
        "unsupported"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ref",
          "format",
          "media_type",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "validation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "status",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "status",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "baseline_receipt": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "result_ref": {
          "type": "object",
          "properties": {
            "result_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "result_id",
            "revision"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "restored": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "result_ref",
        "sha256",
        "restored"
      ],
      "additionalProperties": false
    },
    "continuation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "result_ref",
    "spec_id",
    "renderer_id",
    "status",
    "artifact_refs",
    "validation_results",
    "warnings",
    "feature_checks",
    "baseline_receipt",
    "continuation_refs"
  ],
  "additionalProperties": false
}
